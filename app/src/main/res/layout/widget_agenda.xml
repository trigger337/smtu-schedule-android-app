<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <TextView
        android:id="@+id/wa_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/w_ring_lesson" />

    <TextView
        android:id="@+id/wa_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/w_text" />

    <TextView
        android:id="@+id/wa_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/w_sub" />

    <ProgressBar
        android:id="@+id/wa_bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="3dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:progressDrawable="@drawable/bar_lesson"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/wa_nh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="9sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:textColor="@color/w_sub" />

    <LinearLayout
        android:id="@+id/wa_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/wa_r1_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/w_ring_lesson" />

        <TextView
            android:id="@+id/wa_r1_subj"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/w_text" />

        <TextView
            android:id="@+id/wa_r1_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="10sp"
            android:maxLines="1"
            android:textColor="@color/w_sub" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wa_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/wa_r2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/w_ring_lesson" />

        <TextView
            android:id="@+id/wa_r2_subj"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/w_text" />

        <TextView
            android:id="@+id/wa_r2_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="10sp"
            android:maxLines="1"
            android:textColor="@color/w_sub" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wa_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/wa_r3_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/w_ring_lesson" />

        <TextView
            android:id="@+id/wa_r3_subj"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/w_text" />

        <TextView
            android:id="@+id/wa_r3_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="10sp"
            android:maxLines="1"
            android:textColor="@color/w_sub" />
    </LinearLayout>
</LinearLayout>
