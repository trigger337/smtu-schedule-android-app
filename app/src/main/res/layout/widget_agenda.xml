<?xml version="1.0" encoding="utf-8"?>
<!-- Agenda widget, 2x4 vertical variant: the bitmap text panel on top, the
     timeline tile below with the marker at the bottom edge and the future
     running upward, countdown ring inside. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/wa_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitXY" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/w_ring_track"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/wa_tile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />
</LinearLayout>
